# PlantWise Environment Configuration
# Copy this file to .env and fill in the values below.
# NEVER commit .env to version control.

# == Flask ==
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-strong-secret-key-here

# == PostgreSQL Database ==
# Local development
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=your-postgres-password-here
DB_NAME=crop_advisory
DB_PORT=5432

# Production (Railway/Heroku): set DATABASE_URL instead
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# == OpenRouter AI Vision API (free tier) ==
# Sign up at https://openrouter.ai/ and create a free API key.
# Required for image-based disease diagnosis.
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# == Optional ==
FLASK_ENV=production
FLASK_DEBUG=False
